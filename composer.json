{
    "name": "momotombo/nativephp-pull-to-refresh",
    "description": "Customizable animated pull-to-refresh UI component for NativePHP Mobile on iOS and Android.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "android",
        "ios",
        "laravel",
        "nativephp",
        "nativephp-plugin",
        "pull-to-refresh"
    ],
    "homepage": "https://github.com/momotombodevs/nativephp-pull-to-refresh",
    "support": {
        "issues": "https://github.com/momotombodevs/nativephp-pull-to-refresh/issues",
        "source": "https://github.com/momotombodevs/nativephp-pull-to-refresh"
    },
    "authors": [
        {
            "name": "Momotombo"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.5",
        "nativephp/mobile-ui": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "Momotombo\\NativePhpPullToRefresh\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momotombo\\NativePhpPullToRefresh\\NativePhpPullToRefreshServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
